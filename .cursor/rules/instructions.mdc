# Cтруктура таблиц проекта (Схема MessagingCore)

# Таблица Rassylka_Reklamy_wazzup
    Данная таблица хранит в себе информацию о заказах из 1С пополняется кадый день (Пока не пополняется)

# DLL Таблицы
    CREATE TABLE "MessagingCore"."Rassylka_Reklamy_wazzup" (
	"Data" date NOT NULL,
	"MagazinSalon" varchar(100) NOT NULL,
	"NomerTelefona" varchar(11) NOT NULL,
	"ParametrDataNachala" date NOT NULL,
	"ParametrDataOkonchaniya" date NOT NULL
);
CREATE INDEX "Rassylka_Reklamy_wazzup_Segment_idx" ON "MessagingCore"."Rassylka_Reklamy_wazzup" USING btree ("ParametrDataNachala", "ParametrDataOkonchaniya");


# Описание колонок 
"Data" - дата выгрузки
"MagazinSalon" - Хранит тип магазина (Название салона, Название интернет магазина, и прои)
NomerTelefona - Номер телефона клиента  есть пустые поля, поля не пустые если MagazinSalon является Магазином
ParametrDataNachala - Поля из 1с
ParametrDataOkonchaniya - Поля из 1с

